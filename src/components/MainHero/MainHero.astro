---
//@ts-nocheck
import "./_main-hero.scss";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { Picture } from "astro:assets";
import Button from "@/components/Button/Button.astro";
import heroImageDesk from "@/assets/img/hero.png";
import heroImageTabletM from "@/assets/img/hero-tablet-m.png";
import heroImageTabletS from "@/assets/img/hero-tablet-s.png";
import { getImage } from "astro:assets";
const optimazedDesktop = await getImage({ src: heroImageDesk, format: "webp" });
const optimazedTabletM = await getImage({
  src: heroImageTabletM,
  format: "webp",
});
const optimazedTabletS = await getImage({
  src: heroImageTabletS,
  format: "webp",
});
---

<section class="hero container">
  <div class="hero__text">
    <h1 class="hero__title title--h1">Простые вещи. Из бумаги</h1>
    <p class="hero__desc desc">
      Бума́га ( от итал. bombagia, первоисточником же считается иранский) —
      волокнистый материал с минеральными добавками.
    </p>
    <Button label="Каталог" class="hero__btn"/>
  </div>

  <div class="hero__img">
    <picture>
      <source media="(min-width:800px)" srcset={optimazedDesktop.src} />
      <source media="(min-width:700px)" srcset={optimazedTabletM.src} />
      <source media="(min-width:610px)" srcset={optimazedTabletS.src} />
      <img
        src={optimazedTabletS.src}
        alt="Главная картинка"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>
</section>
